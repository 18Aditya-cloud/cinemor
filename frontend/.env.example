# Copy this file to .env (development) or .env.production (build) and edit.

# Address of the Cinemor backend (FastAPI). For local development: http://localhost:8000
# Leave EMPTY to run the frontend alone in demo mode (no network calls are made).
# Tip: open the site at http://localhost:5173 (not 127.0.0.1) so the login cookie is sent to localhost:8000.
VITE_API_URL=

# "Sign in with Google" goes through Supabase (the backend checks the Supabase token).
# Use the same Supabase project as the backend's SUPABASE_URL. The publishable (anon) key is safe in the browser.
# Also add http://localhost:5173/auth/callback under Supabase > Authentication > URL Configuration > Redirect URLs.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development only: where the Vite dev server forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Only needed if the built site is served from a sub-path, e.g. /static/
VITE_BASE=/

# How pages are addressed. "history" (default) = real addresses like /login. Your server must send
# index.html for /login, /signup and /app (see README, "Pages and routes").
# "memory" = the address bar never changes (used for embedded previews).
VITE_ROUTER_MODE=history
