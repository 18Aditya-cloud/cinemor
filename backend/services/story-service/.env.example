# ============================================================
# Application
# ============================================================

APP_NAME=Cinemor Story Service
APP_VERSION=1.0.0

# MUST be False in production (True exposes stack traces and /docs).
DEBUG=False


# ============================================================
# Database
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cinemor


# ============================================================
# OpenRouter
# ============================================================

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ============================================================
# Supabase (used only for "Sign in with Google")
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY


# ============================================================
# JWT  (base64-encoded PEM keys; see BACKEND-CONNECTION.md to generate)
# ============================================================

JWT_PRIVATE_KEY_B64=YOUR_BASE64_PRIVATE_KEY
JWT_PUBLIC_KEY_B64=YOUR_BASE64_PUBLIC_KEY

JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# Refresh Cookie
# ============================================================

REFRESH_COOKIE_NAME=cinemor_refresh_token

# MUST be True in production (HTTPS). Only set False for local http testing.
REFRESH_COOKIE_SECURE=True
REFRESH_COOKIE_HTTP_ONLY=True
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/api/auth


# ============================================================
# Login Security
# ============================================================

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15


# ============================================================
# Organization
# ============================================================

ORGANIZATION_CODE_LENGTH=12


# ============================================================
# Email (SMTP)
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
EMAIL_FROM=onboarding@yourdomain.com
RESEND_API_KEY=unused


# ============================================================
# Frontend / CORS
# ============================================================

# Used to build invitation and password-reset links.
FRONTEND_URL=https://app.yourdomain.com

# Comma-separated allowed browser origins. NEVER use "*" with credentials.
CORS_ALLOW_ORIGINS=https://app.yourdomain.com


# ============================================================
# Password Security
# ============================================================

# A hash of a RANDOM throwaway string (used only for login timing).
# Generate a fresh one; do NOT reuse the value from any documentation.
DUMMY_PASSWORD_HASH=YOUR_GENERATED_ARGON2_HASH
